msgid "\"Prepared by\" block of the report"
msgstr "Bloque «Preparado por» del informe"

#: includes/class-eclair-export-diagnostic.php:245
msgid "%1$s contents, for %2$s at most in Éclair: split the site or leave old drafts out."
msgstr "%1$s contenidos, para un máximo de %2$s en Éclair: divida el sitio o deje fuera los borradores antiguos."

#: includes/class-eclair-export-diagnostic.php:249
msgid "%1$s files, for %2$s images at most in Éclair: unused files should be cleaned first."
msgstr "%1$s archivos, para un máximo de %2$s imágenes en Éclair: conviene eliminar antes los archivos sin usar."

